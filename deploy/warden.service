[Unit]
Description=Warden - Linux server management panel
Documentation=https://github.com/your/warden
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 需要管理 Docker / 防火墙，因此以 root 运行；
# 若只想管理文件与监控，可改为 www-data 并将用户加入 docker 组
User=root
WorkingDirectory=/opt/warden
ExecStart=/opt/warden/warden -config /opt/warden/config.yaml
Restart=always
RestartSec=3
LimitNOFILE=65535
# 允许绑定 80/443 等低端口
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
